;every fan in these rooms; k = speed (1 = idling)
Function IndevS10Spin(r.Rooms, k#)
	Select r\RoomTemplate\Name
		Case "room2subway052"
			TurnEntity(r\Objects[3], 0, 0, 3.5 * k * FPSfactor)
		Case "room2hall99"
			TurnEntity(r\Objects[9], 0, 0, 5.0 * k * FPSfactor)
		Case "room2gameshow"
			TurnEntity(r\Objects[23], 0, 0, 3.5 * k * FPSfactor)
		Case "room2diner"
			TurnEntity(r\Objects[7], 0, 2.0 * k * FPSfactor, 0)
			TurnEntity(r\Objects[8], 0, 2.0 * k * FPSfactor, 0)
		Case "room2sheet"
			TurnEntity(r\Objects[2], 0, 2.0 * k * FPSfactor, 0)
		Case "room2block15"
			TurnEntity(r\Objects[0], 0, 0, 5.0 * k * FPSfactor)
			TurnEntity(r\Objects[1], 0, 0, 5.0 * k * FPSfactor)
		Case "room2psych"
			TurnEntity(r\Objects[4], 0, 2.0 * k * FPSfactor, 0)
		Case "room2realchar"
			TurnEntity(r\Objects[3], 0, 0, 5.0 * k * FPSfactor)
		Case "room2wait1440"
			TurnEntity(r\Objects[7], 0, 2.0 * k * FPSfactor, 0)
	End Select
End Function

