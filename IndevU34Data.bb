	U34Text(70) = "An okapi carcass, tag 2928, a flap of skin cut away. Inside it is much bigger than an okapi." : U34Fx(70) = "*"
	U34Num(71) = "1705" : U34Cls(71) = "Safe" : U34Title(71) = "The bones"
	U34Text(71) = "Part of a collection of 2,507 notched bones and the diagrams to assemble them. Do not follow the diagrams." : U34Fx(71) = "stress 4"
	U34Num(72) = "1036" : U34Cls(72) = "Euclid" : U34Title(72) = "The figurines"
	U34Text(72) = "Four carved Kongo figures, studded with nails, poised to strike. Their eyes follow the hand that holds them." : U34Fx(72) = "stress 5"
	U34Num(73) = "4617" : U34Cls(73) = "Euclid" : U34Title(73) = "Formaldehyde"
	U34Text(73) = "A man whose every tissue weeps formaldehyde and methanol. His cells are dead. He is not. The smell is very strong." : U34Fx(73) = "blur 3"
	U34Num(74) = "5728" : U34Cls(74) = "Keter" : U34Title(74) = "SK-BIO"
	U34Text(74) = "The last SK-BIO entity from Arlingpool: proto-Sarkic flesh that heals gunshot wounds while you watch." : U34Fx(74) = "stress 8"
	U34Num(75) = "1564" : U34Cls(75) = "Euclid" : U34Title(75) = "The brass ovoids"
	U34Text(75) = "Six brass and beryllium-bronze eggs of 216 kg. Every tool that tries to open one breaks. Something inside is big." : U34Fx(75) = "shake 1"
	U34Num(76) = "1575" : U34Cls(76) = "Safe" : U34Title(76) = "Venus fountain"
	U34Text(76) = "A 2.75 m marble Venus built as a fountainhead; the water once ran from her mouth. The basin is dry." : U34Fx(76) = "*"
	U34Num(77) = "3085" : U34Cls(77) = "Keter" : U34Title(77) = "The grey sphere"
	U34Text(77) = "A grey sphere floating 1.5 m up. Nothing near it casts a shadow, and it is growing." : U34Fx(77) = "*"
	U34Num(78) = "1255" : U34Cls(78) = "Euclid" : U34Title(78) = "The grapes"
	U34Text(78) = "Red globe grapes with microscopic seeds. Eat one and something sprouts." : U34Fx(78) = ""
	U34Num(79) = "4193" : U34Cls(79) = "Safe" : U34Title(79) = "Blue caplets"
	U34Text(79) = "Thirty-two blue caplets with a bunny embossed on them. The first one cures any headache instantly." : U34Fx(79) = ""
	U34Num(80) = "5604" : U34Cls(80) = "Safe" : U34Title(80) = "R-IN"
	U34Text(80) = "Fifty-seven dark red methaqualone tablets stamped 'R-IN'. You will not be yourself." : U34Fx(80) = ""
	U34Num(81) = "2983" : U34Cls(81) = "Safe" : U34Title(81) = "Choco-Wonder"
