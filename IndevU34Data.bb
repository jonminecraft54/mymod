	U34Num(83) = "2999" : U34Cls(83) = "Euclid" : U34Title(83) = "Sarah_Crowely.txt"
	U34Text(83) = "A sapient 5 KB text file from Prometheus Labs: ASCII in a Celtic knot round a rabbit's face." : U34Fx(83) = "stress 3"
	U34Num(84) = "5701" : U34Cls(84) = "Safe" : U34Title(84) = "The Polaroid"
