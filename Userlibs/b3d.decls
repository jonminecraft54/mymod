.lib "B3D.dll"
bbInit%() : "bbInit"
bbSetGadgetFont%(gadget%, font%) : "bbSetGadgetFont"
bbGraphics3D%(width%, height%, depth%, mode%) : "bbGraphics3D"
bbEndGraphics%() : "bbEndGraphics"
bbCreateCamera%(parent%) : "bbCreateCamera"
bbCameraClsColor%(camera%, red%, green%, blue%) : "bbCameraClsColor"
bbCameraViewport%(camera%, x%, y%, width%, height%) : "bbCameraViewport"
bbRenderWorld%(tween#) : "bbRenderWorld"
bbUpdateWorld%(anim_speed#) : "bbUpdateWorld"
bbFlip%(vwait%) : "bbFlip"
bbKeyHit%(key%) : "bbKeyHit"
bbKeyDown%(key%) : "bbKeyDown"
bbCreateCube%(parent%) : "bbCreateCube"
bbCreateSphere%(segments%, parent%) : "bbCreateSphere"
bbCreatePivot%(parent%) : "bbCreatePivot"
bbPositionEntity%(entity%, x#, y#, z#, global%) : "bbPositionEntity"
bbRotateEntity%(entity%, pitch#, yaw#, roll#, global%) : "bbRotateEntity"
bbScaleEntity%(entity%, x#, y#, z#, global%) : "bbScaleEntity"
bbMoveEntity%(entity%, x#, y#, z#) : "bbMoveEntity"
bbTurnEntity%(entity%, pitch#, yaw#, roll#, global%) : "bbTurnEntity"
bbLoadMesh$(filename$, parent%) : "bbLoadMesh"
bbLoadTexture$(filename$, flags%) : "bbLoadTexture"
bbEntityTexture%(entity%, texture%, frame%, index%) : "bbEntityTexture"
bbCreateLight%(type%, parent%) : "bbCreateLight"
bbLightColor%(light%, red#, green#, blue#) : "bbLightColor"