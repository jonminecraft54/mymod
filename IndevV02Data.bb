;which NPC a room has (see UpdateIndevV02)
Function IndevV02Role$(n$)
	Select n
		Case "room2w_checkpoint" Return "guard"
		Case "room2w_infirm" Return "liej"
		Case "room2w_dclass" Return "sitd"
		Case "room2cw_guard" Return "guard"
		Case "room3w_office" Return "sci"
		Case "room1w_ward" Return "lie"
		Case "room1w_tank" Return "tech"
	End Select
	Return ""
End Function

;the way that NPC faces, relative to the room
Function IndevV02Yaw%(n$)
	Select n
		Case "room2w_checkpoint" Return 90
		Case "room2w_infirm" Return 200
		Case "room2w_dclass" Return 0
		Case "room2cw_guard" Return 180
		Case "room3w_office" Return 180
		Case "room1w_ward" Return 30
		Case "room1w_tank" Return 60
	End Select
	Return 0
End Function

;rare-item category of a room (IndevRoomTag in IndevRareSpawn.bb falls back to this)
Function IndevV02Tag$(n$)
	Select n
		Case "room2w_consoles", "room2w_lab", "room2cw_lab", "room3w_console", "room1w_consoles" Return "testing"
		Case "room2w_meeting", "room2w_whitedoor", "room2w_archive", "room3w_office", "room1w_meeting", "room1w_whitedoor" Return "office"
		Case "room2w_canteen" Return "cafeteria"
		Case "room2w_lift2", "room2w_cages", "room2cw_store", "room3w_store", "room1w_cache" Return "storage"
		Case "room2w_infirm", "room1w_ward" Return "medical"
	End Select
	Return ""
End Function
