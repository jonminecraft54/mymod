;every fan in these rooms; k = speed (1 = idling)
Function IndevS16Spin(r.Rooms, k#)
	Select r\RoomTemplate\Name
		Case "room2siv"
			TurnEntity(r\Objects[4], 0, 2.0 * k * FPSfactor, 0)
		Case "room2bio"
			TurnEntity(r\Objects[17], 0, 2.0 * k * FPSfactor, 0)
		Case "room2origin"
			TurnEntity(r\Objects[0], 0, 0, 5.0 * k * FPSfactor)
		Case "room2purge"
			TurnEntity(r\Objects[0], 0, 0, 5.0 * k * FPSfactor)
			TurnEntity(r\Objects[1], 0, 0, 5.0 * k * FPSfactor)
		Case "room2cell49"
			TurnEntity(r\Objects[0], 0, 0, 5.0 * k * FPSfactor)
		Case "room2bunker"
			TurnEntity(r\Objects[3], 0, 0, 3.5 * k * FPSfactor)
	End Select
End Function

