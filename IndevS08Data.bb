;every fan in these rooms; k = speed (1 = idling)
Function IndevS08Spin(r.Rooms, k#)
	Select r\RoomTemplate\Name
		Case "room2yule"
			TurnEntity(r\Objects[6], 0, 2.0 * k * FPSfactor, 0)
			TurnEntity(r\Objects[14], 0, 2.0 * k * FPSfactor, 0)
		Case "room2pinata"
			TurnEntity(r\Objects[12], 0, 2.0 * k * FPSfactor, 0)
		Case "room2argos"
			TurnEntity(r\Objects[3], 0, 0, 5.0 * k * FPSfactor)
			TurnEntity(r\Objects[4], 0, 0, 5.0 * k * FPSfactor)
			TurnEntity(r\Objects[9], 0, 0, 3.5 * k * FPSfactor)
		Case "room2demoncore"
			TurnEntity(r\Objects[7], 0, 0, 3.5 * k * FPSfactor)
			TurnEntity(r\Objects[8], 0, 0, 3.5 * k * FPSfactor)
		Case "room2chrono"
			TurnEntity(r\Objects[3], 0, 0, 3.5 * k * FPSfactor)
	End Select
End Function

