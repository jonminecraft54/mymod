;=====================================================================
; SCP: Containment Breach - Indev zone filler rooms in the v0.1 style, "w" series
;
;   55 more generated rooms (24 hallways, 10 corners, 9 T junctions, 6 crossroads,
;   6 dead ends), random filler for the Indev zone like the first 24 (IndevV01.bb).
;   IndevV02Data.bb is generated by Tools\roomkit\gen_v02.py: the FillRoom table,
;   the event list, which NPC a room has and which rare-item category it is.
;
;   This file is the shared event ("v02room"):
;     - fans turn (duct fan, ceiling fan, the big extractor in room4w_fan)
;     - lifts run (room2w_lift2 up to a store, room1w_cache down to a cache)
;     - the room's NPC, by role:
;         guard  an idle guard behind a hatch, with a few lines
;         tech   a plant technician (alive), with a few lines
;         sci    a researcher (alive), with a few lines
;         sit / sitd / lie / liej   bodies
;   No globals. EventState 1 = NPC placed, EventState2 lift, EventState3 pause
;   between lines.
;=====================================================================

Function UpdateIndevV02(e.Events)
	Local r.Rooms = e\room
	Local n.NPCs, d#, role$

	If r\dist < 10.0 Then
		If r\Objects[2] <> 0 Then TurnEntity(r\Objects[2], 0, 0, 5.0 * FPSfactor)
		If r\Objects[3] <> 0 Then TurnEntity(r\Objects[3], 0, 2.0 * FPSfactor, 0)
		If r\Objects[5] <> 0 Then TurnEntity(r\Objects[5], 0, 0, 3.5 * FPSfactor)
	EndIf
	If PlayerRoom <> r Then Return

	If r\Objects[0] <> 0 And r\Objects[1] <> 0 Then
		If r\RoomDoors[0] <> Null And r\RoomDoors[1] <> Null Then
			e\EventState2 = UpdateElevators(e\EventState2, r\RoomDoors[0], r\RoomDoors[1], r\Objects[0], r\Objects[1], e)
		EndIf
	EndIf
	If KillTimer < 0 Then Return
	If r\Objects[4] = 0 Then Return

	role = IndevV02Role(r\RoomTemplate\Name)
	If role = "" Then Return

	;---- placed the first time the player walks in
	If e\EventState = 0 Then
		e\EventState = 1
		Local px# = EntityX(r\Objects[4], True), py# = EntityY(r\Objects[4], True), pz# = EntityZ(r\Objects[4], True)
		Local yaw# = EntityYaw(r\obj, True) + IndevV02Yaw(r\RoomTemplate\Name)
		Select role
			Case "guard"
				n = CreateNPC(NPCtypeGuard, px, py + 0.35, pz)
				n\State = 9
			Case "tech", "sci"
				n = CreateNPC(NPCtypeD, px, py + 0.5, pz)
				n\State = 0
			Case "sit", "sitd"
				n = CreateNPC(NPCtypeD, px, py + 0.5, pz)
				n\State = 3
				SetNPCFrame(n, 40)
				n\IsDead = True
			Default
				n = CreateNPC(NPCtypeD, px, py + 0.5, pz)
				n\State = 3
				SetNPCFrame(n, 19)
				n\IsDead = True
		End Select
		RotateEntity(n\Collider, 0, yaw, 0)
		r\NPC[0] = n
	EndIf

	n = r\NPC[0]
	If n = Null Then Return
	If e\EventState3 > 0 Then e\EventState3 = e\EventState3 - FPSfactor
	d = EntityDistance(n\Collider, Collider)

	Select role
		Case "sit"
			IAxSkin(n, "GFX\npcs\scientist.jpg")
		Case "lie"
			IAxSkin(n, "GFX\npcs\body1.jpg")
		Case "liej"
			IAxSkin(n, "GFX\npcs\janitor.jpg")
		Case "guard"
			n\State = 9
			If d < 2.6 And e\EventState3 <= 0 And MsgTimer <= 0 Then
				Select Rand(4)
					Case 1 IAxSay("Guard", "This post is closed. Go round.", 5)
					Case 2 IAxSay("Guard", "I've got orders to hold this hatch and nobody left to give me new ones.", 6)
					Case 3 IAxSay("Guard", "If you hear stone dragging, don't run. Look at it and back away.", 6)
					Case 4 IAxSay("Guard", "Lights went twice in the last hour. I counted the people who walked past after. Fewer.", 7)
				End Select
				e\EventState3 = 70 * 40
			EndIf
		Case "tech"
			IAxSkin(n, "GFX\npcs\indev_tech.jpg")
			If d < 6.0 Then
				IAxFace(n, Collider)
			Else
				n\State = 0
			EndIf
			If d < 2.6 And e\EventState3 <= 0 And MsgTimer <= 0 Then
				Select Rand(3)
					Case 1 IAxSay("Technician", "Don't lean on the tank. It's the only thing in this wing still doing its job.", 6)
					Case 2 IAxSay("Technician", "If the fan stops, the gauge climbs. If the gauge climbs, I leave. Until then I'm staying.", 7)
					Case 3 IAxSay("Technician", "Stores are two junctions back if you want a mask. Take one. I would.", 6)
				End Select
				e\EventState3 = 70 * 45
			EndIf
		Case "sci"
			IAxSkin(n, "GFX\npcs\indev_archivist.jpg")
			If d < 6.0 Then
				IAxFace(n, Collider)
			Else
				n\State = 0
			EndIf
			If d < 2.6 And e\EventState3 <= 0 And MsgTimer <= 0 Then
				Select Rand(3)
					Case 1 IAxSay("Researcher", "The meeting was at nine. Nobody came. I thought I'd wait in case it was only late.", 7)
					Case 2 IAxSay("Researcher", "Take the book if you want it. It's the minutes. There aren't any.", 6)
					Case 3 IAxSay("Researcher", "They test the sculpture in the old yard no longer. You'd think that would mean it isn't here.", 7)
				End Select
				e\EventState3 = 70 * 45
			EndIf
	End Select
End Function
