;=====================================================================
; SCP: Containment Breach - Indev: twentieth batch, SCP-3008 and four containment wings (eight SCPs)
;
;   room2b20store3008  SCP-3008: after 45 s in the store it "closes": an announcement, and four faceless staff
;                      appear. They stand by day; at closing they walk towards you, and touching them hurts.
;   room2b20wing999    SCP-999 (an orange jelly that comes to you and lowers stress) and SCP-131 (two eye pods
;                      that follow you about the wing).
;   room2b20wing529    SCP-529 (pet her: stress -5) and SCP-111 (the dragon-snails: a spark, a small burn).
;   room2b20wing458    SCP-458 (a slice heals a little, once a minute) and SCP-261 (a random snack).
;   room2b20wing2295   SCP-241 (the cookbook: a recipe, and the notes in its margins) and SCP-113 (hurts, once).
;   (SCP-330 and SCP-2295 were here until batch 25; both already existed in the game, so they were replaced.)
;
;   The SCP texts are summaries of SCP Wiki articles (CC BY-SA 3.0). IndevU20Data.bb is generated by
;   Tools\roomkit\gen_b20.py. Every event returns at once when the player is not in its room.
;=====================================================================

Global Indev20Jelly%, Indev20Pod0%, Indev20Pod1%
Global Indev20Closed%, Indev20Uses%

Function IndevU20Dress(r.Rooms)
	Select r\RoomTemplate\Name
		Case "room2b20wing999"
			Indev20Jelly = CreateSphere(10)
			ScaleEntity(Indev20Jelly, 0.28, 0.2, 0.28)
			EntityColor(Indev20Jelly, 255, 140, 20)
			EntityShininess(Indev20Jelly, 0.8)
			EntityAlpha(Indev20Jelly, 0.9)
			PositionEntity(Indev20Jelly, EntityX(r\Objects[U20_W999_S999], True), EntityY(r\Objects[U20_W999_S999], True) + 0.2, EntityZ(r\Objects[U20_W999_S999], True))
			Indev20Pod0 = IndevU20Pod(r, 230, 220, 160, -0.3)
			Indev20Pod1 = IndevU20Pod(r, 150, 200, 255, 0.3)
		;real models on the cells' props (IndevScpProps.bb): slot order as in IndevU20Data.bb
		Case "room2b20wing458"
			IndevScpDressList(r, "458|261")
		Case "room2b20wing2295"
			IndevScpDressList(r, "241|113")
	End Select
End Function

;one of SCP-131's eye pods: a small teardrop of colour with a dark eye
Function IndevU20Pod%(r.Rooms, cr%, cg%, cb%, dz#)
	Local p% = CreateSphere(8), eye% = CreateSphere(6, p)
	ScaleEntity(p, 0.1, 0.16, 0.1)
	EntityColor(p, cr, cg, cb)
	ScaleEntity(eye, 0.5, 0.35, 0.3)
	PositionEntity(eye, 0, 0.3, 0.85)
	EntityColor(eye, 10, 10, 10)
	PositionEntity(p, EntityX(r\Objects[U20_W999_S131], True), EntityY(r\Objects[U20_W999_S131], True) + 0.16, EntityZ(r\Objects[U20_W999_S131], True) + dz)
	Return p
End Function

Function UpdateIndevU20(e.Events)
	If PlayerRoom <> e\room Then Return
	Select e\room\RoomTemplate\Name
		Case "room2b20store3008"
			UpdateU20Store(e)
		Case "room2b20wing999"
			UpdateU20Jelly(e)
		Case "room2b20wing529"
			UpdateU20Cat(e)
		Case "room2b20wing458"
			UpdateU20Snacks(e)
		Case "room2b20wing2295"
			UpdateU20Bear(e)
	End Select
End Function

;SCP-3008. Flag c: the store has closed. EventState: frames until closing.
Function UpdateU20Store(e.Events)
	Local r.Rooms = e\room, k%, n.NPCs, d#
	If Not IAxFlag(e, "s") Then
		IAxSetFlag(e, "s")
		e\EventState = 70 * 45
		IS16Tell("Welcome. The store is open. Please follow the arrows.", 5)
	EndIf
	If Not IAxFlag(e, "c") Then
		e\EventState = e\EventState - FPSfactor
		If e\EventState > 0 Then Return
		IAxSetFlag(e, "c")
		Indev20Closed = Indev20Closed + 1
		IS10Sound("SFX\Indev\ding.wav", r\Objects[U20_STR_SPEAKER], 30.0, 1.0)
		IS16Tell("Attention, shoppers. The store is now closed. Please make your way to the nearest exit.", 8)
		For k = 0 To 3
			r\NPC[k] = IS16Person(r, U20_STR_STAFF0 + k, 0)
			IAxSkin(r\NPC[k], "GFX\npcs\indev_3008staff.jpg")
		Next
	EndIf
	For k = 0 To 3
		n = r\NPC[k]
		If n <> Null Then
			d = EntityDistance(n\Collider, Collider)
			IAxFace(n, Collider)
			If d < 10.0 And d > 0.8 Then MoveEntity(n\Collider, 0, 0, 0.012 * FPSfactor)
			If d < 0.9 Then
				Injuries = Injuries + 0.004 * FPSfactor
				If MsgTimer <= 0 Then IS16Tell("It has no face. It does not stop.", 3)
			EndIf
		EndIf
	Next
End Function

;SCP-999 comes to you and hugs; SCP-131 follow at your heels. Both stay inside the wing.
Function UpdateU20Jelly(e.Events)
	Local r.Rooms = e\room, d#
	d = EntityDistance(Indev20Jelly, Collider)
	If d > 0.7 Then
		IndevU20Follow(Indev20Jelly, Collider, 0.02, r)
	Else
		IndevStress = IndevStress - 0.05 * FPSfactor
	EndIf
	If IndevStress < 0 Then IndevStress = 0
	If d < 0.8 And (Not IAxFlag(e, "h")) Then
		IAxSetFlag(e, "h")
		Indev20Uses = Indev20Uses + 1
		IS16Tell("SCP-999 wraps itself round your legs. You feel ridiculously happy.", 6)
	EndIf
	If EntityDistance(Indev20Pod0, Collider) > 1.0 Then IndevU20Follow(Indev20Pod0, Collider, 0.03, r)
	If EntityDistance(Indev20Pod1, Collider) > 1.3 Then IndevU20Follow(Indev20Pod1, Collider, 0.03, r)
	PointEntity(Indev20Pod0, Camera) : PointEntity(Indev20Pod1, Camera)
	RotateEntity(Indev20Pod0, 0, EntityYaw(Indev20Pod0), 0) : RotateEntity(Indev20Pod1, 0, EntityYaw(Indev20Pod1), 0)
End Function

;slide a free entity towards the player on the floor plane, but no further than 4 m from the room's centre
Function IndevU20Follow(ent%, tgt%, speed#, r.Rooms)
	Local dx# = EntityX(tgt) - EntityX(ent), dz# = EntityZ(tgt) - EntityZ(ent), l# = Sqr(dx * dx + dz * dz)
	Local nx#, nz#
	If l < 0.01 Then Return
	nx = EntityX(ent) + dx / l * speed * FPSfactor
	nz = EntityZ(ent) + dz / l * speed * FPSfactor
	If Abs(nx - EntityX(r\obj)) < 4.0 And Abs(nz - EntityZ(r\obj)) < 4.0 Then PositionEntity(ent, nx, EntityY(ent), nz)
End Function

;SCP-529 (east): pet her. SCP-111 (west): the dragon-snails, a spark each time.
Function UpdateU20Cat(e.Events)
	Local r.Rooms = e\room
	If IS10Press(r\Objects[U20_W529_S529], 2.0) Then
		Indev20Uses = Indev20Uses + 1
		IndevStress = IndevStress - 5 : If IndevStress < 0 Then IndevStress = 0
		IS16Tell("You pet Josie. She purrs. You try not to look at where the rest of her should be.", 6)
	EndIf
	If IS10Press(r\Objects[U20_W529_S111], 2.0) Then
		Indev20Uses = Indev20Uses + 1
		Injuries = Injuries + 0.1
		IS10Sound("SFX\Indev\fire.wav", r\Objects[U20_W529_S111], 6.0, 0.6)
		IS16Tell("You lean over the terrarium. One of the snails sneezes a tiny jet of flame at your nose.", 6)
	EndIf
End Function

;SCP-458 (east): a slice of pizza, once a minute (EventState3 the cooldown). SCP-261 (west): a snack.
Function UpdateU20Snacks(e.Events)
	Local r.Rooms = e\room
	If e\EventState3 > 0 Then e\EventState3 = e\EventState3 - FPSfactor
	If IS10Press(r\Objects[U20_W458_S458], 2.0) Then
		Indev20Uses = Indev20Uses + 1
		If e\EventState3 > 0 Then
			IS16Tell("You are still full.", 3)
		Else
			e\EventState3 = 70 * 60
			Injuries = Injuries - 0.3 : If Injuries < 0 Then Injuries = 0
			IS16Tell("The box is warm. Inside is a fresh pizza, exactly the kind you like best.", 6)
		EndIf
	EndIf
	If IS10Press(r\Objects[U20_W458_S261], 2.0) Then
		Indev20Uses = Indev20Uses + 1
		IS10Sound("SFX\Indev\clicks.wav", r\Objects[U20_W458_S261], 6.0, 0.7)
		Select Rand(4)
			Case 1
				IS16Tell("SCP-261 drops a can of green tea. It is very good green tea.", 5)
			Case 2
				IS16Tell("SCP-261 drops a packet of crisps that taste of the sea.", 5)
			Case 3
				IS16Tell("SCP-261 drops a small box. It ticks. You put it back.", 5)
			Case 4
				IS16Tell("SCP-261 drops a sandwich, still in its plastic, dated next Thursday.", 5)
		End Select
	EndIf
End Function

;SCP-241 (east): the cookbook, a recipe and a margin note; the first read calms you (flag b). SCP-113 (west): hurts, once (flag j).
Function UpdateU20Bear(e.Events)
	Local r.Rooms = e\room
	If IS10Press(r\Objects[U20_W2295_S241], 2.0) Then
		Indev20Uses = Indev20Uses + 1
		If IAxFlag(e, "b") Then
			IndevStress = IndevStress + 8 : If IndevStress > 100 Then IndevStress = 100
			IS16Tell("A note in the margin, in neat handwriting: 'This one is lovely with a friend. Try it on whoever is nearest.'", 7)
		Else
			IAxSetFlag(e, "b")
			Stamina = 100
			IndevStress = IndevStress - 5 : If IndevStress < 0 Then IndevStress = 0
			IS16Tell("Good Home Cooking. A recipe for apple pie, warm and simple. Reading it, you can almost smell it.", 7)
		EndIf
	EndIf
	If IS10Press(r\Objects[U20_W2295_S113], 2.0) And (Not IAxFlag(e, "j")) Then
		IAxSetFlag(e, "j")
		Indev20Uses = Indev20Uses + 1
		Injuries = Injuries + 0.5
		IndevStress = IndevStress + 10 : If IndevStress > 100 Then IndevStress = 100
		IndevGenderSwap() ;it is SCP-113: the change is real (IndevSide.bb)
		IS16Tell("The stone is hot in your hand, then everything is. You drop it. You feel... different. Your body has changed.", 7)
	EndIf
End Function
